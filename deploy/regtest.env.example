# Paths only. Keep credential files in their existing VM locations.
# Explicit regtest read-only deployment: uses loopback read-only Core/LND diagnostics.
# For offline simulation use deploy/simulation.env.example instead.
APP_MODE=regtest
ENABLE_LIVE_SWAPS=false
PORT=3000
DATA_DIR=./data
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_COOKIE_PATH=/home/truja/.bitcoin/regtest/.cookie
BITCOIN_WALLET=lqwd-lab
LND_REST_URL=https://127.0.0.1:8080
LND_TLS_CERT_PATH=/home/truja/.lnd/tls.cert
LND_MACAROON_PATH=/home/truja/.lnd/data/chain/bitcoin/regtest/readonly.macaroon
