{
  "name": "lqwd-swap-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx --test --test-name-pattern=OFFLINE tests/coordinator.test.ts",
    "secrets:check": "node scripts/check-secrets.mjs",
    "start": "tsx src/main.ts",
    "inspect": "tsx scripts/inspect.ts"
  },
  "dependencies": {
    "bitcoinjs-lib": "7.0.0",
    "ecpair": "3.0.0",
    "tiny-secp256k1": "2.2.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
